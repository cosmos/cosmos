msc {

    # The entities (Blockchains)
    Zone1, Hub, Zone2;

    ||| "Initial Packet Send (Zone1 -> Hub -> Zone2)";

    # Relayer relays Zone1's block header to Hub (MsgUpdateClient)
    Zone1 => Hub [ label = "MsgUpdateClient(Zone1_Header:100)"];

    # Relayer relays the packet committed on Zone1 to Hub (MsgRecvPacket)
    Zone1 => Hub [ label = "MsgRecvPacket(Packet_A)\nSourceChain=Zone1"];

    # Hub processes the packet, commits the state change, and commits Hub's block header to Zone2
    Hub => Zone2 [ label = "MsgUpdateClient(Hub_Header:300)"];

    # Relayer relays the packet (now received by Hub) to Zone2 (MsgRecvPacket)
    Hub => Zone2 [ label = "MsgRecvPacket(Packet_A)\nSourceChain=Hub"];

    ||| "Acknowledgement Attempt (Zone2 -> Hub)";

    # Zone2 processes Packet A, commits the result, and tries to send the ACK back to Hub.
    # The ACK transaction fails to reach Hub (or is maliciously withheld/dropped).
    Zone2 -x Hub [ label = "MsgAcknowledgement\nACK_Txn_Failed/Dropped", textcolor="gray", linecolor="gray"];

    |||;

    --- [ label = "Timeout Height Reached on Zone1's Client on Hub"];

    ||| "Timeout Processing (Hub -> Zone1)";

    # Relayer updates Zone1's client on Hub to a height (e.g., 351) that is beyond Packet A's timeout height.
    Hub => Zone1 [ label = "MsgUpdateClient(Hub_Header:351)"];

    # Relayer submits proof that Zone2 (the destination chain) did not receive or process the packet
    # before the timeout height was reached, effectively reversing the packet state on Zone1.
    Hub => Zone1 [ label = "MsgTimeout(Packet_A_Proof)\nStatus=Reverted"];
}
